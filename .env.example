# ==========================================
# FDS (Fraud Detection System) Environment Variables
# 이 파일을 복사해 .env로 저장한 뒤 필요에 맞게 값을 수정하세요.
# ==========================================

# 1. MariaDB
MARIADB_ROOT_PASSWORD=rootpassword
MARIADB_DATABASE=fds_db
MARIADB_USER=fds_user
MARIADB_PASSWORD=fdspassword
DB_URL=jdbc:mariadb://localhost:3306/fds_db

# 2. Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# 3. Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# 4. Spring Security & JWT
# Base64 인코딩된 256-bit 이상 시크릿 (운영 시 반드시 교체)
JWT_SECRET=dGhpcyBpcyBhIHNlY3VyZSBzZWNyZXQga2V5IGZvciBmZHMgc3lzdGVt
JWT_ACCESS_EXP_MS=1800000
JWT_REFRESH_EXP_MS=604800000
FDS_INGEST_API_KEY=fds-demo-api-key-change-me
FDS_ADMIN_USERNAME=admin
FDS_ADMIN_PASSWORD=admin1234!
FDS_VIEWER_USERNAME=viewer
FDS_VIEWER_PASSWORD=viewer1234!
FDS_CORS_ORIGINS=http://localhost:5173

# 5. AI / Detection
FDS_FRAUD_THRESHOLD=80.0
FDS_MODEL_PATH=models/lgbm_fraud_v1.joblib
